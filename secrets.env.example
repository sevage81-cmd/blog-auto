# 이 파일을 secrets.env 로 복사하고 값을 채우세요. secrets.env 는 git에 안 올라갑니다.
# run.ps1 이 실행 시 이 값들을 환경변수로 올려서 claude 파이프라인에 전달합니다.

# Google AI Studio (https://aistudio.google.com/apikey) 에서 발급
GEMINI_API_KEY=

# (선택) 이미지 생성 모델 ID 를 바꾸고 싶을 때만. 기본값이면 이 줄은 비워두세요.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview
